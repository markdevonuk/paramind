rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ============================================
    // ADMIN EMAIL WHITELIST
    // ============================================
    function isAdmin() {
      return request.auth != null && 
             request.auth.token.email in [
               'markdevon@gmail.com'
               // Add more admin emails as needed:
               // 'another-admin@example.com',
             ];
    }
    
    // Trusts collection - anyone can read, no one can write (except admin)
    match /trusts/{trustId} {
      allow read: if true;
      allow write: if false;
    }
    
    // Users collection - users can only read/write their own document
    // Admins can read ALL user documents and delete any document
    match /users/{userId} {
      allow read: if request.auth != null && 
                    (request.auth.uid == userId || isAdmin());
      allow write: if request.auth != null && request.auth.uid == userId;
      allow delete: if isAdmin();
    }
    
    // Conversations subcollection - users can only access their own
    match /users/{userId}/conversations/{conversationId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // CPD Records subcollection - users can only access their own
    match /users/{userId}/cpdRecords/{recordId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Activity Log subcollection - users can only access their own
    match /users/{userId}/activityLog/{sessionId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // News articles - logged-in users can read, admin can write
    match /news/{articleId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // What's New articles - logged-in users can read, only admin can write
    // Drives whatsnew.html (a feed of articles) and admin.html articles manager
    match /articles/{articleId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Config collection - any logged-in user can read, only admins can write
    match /config/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Analytics collection - authenticated users can write (increment counters),
    // only admins can read (keeps platform data private)
    match /analytics/{docId} {
      allow read: if isAdmin();
      allow write: if request.auth != null;
    }

    // A&P Connections cache - any logged-in user can read pre-generated responses
    // Only Cloud Functions (server-side) can write
    match /connectionsCache/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Coroner's Court visit registrations (coroners-court.html)
    // Public create-only with strict validation — server-enforced @swast.nhs.uk
    // email check. Duplicate prevention: the page uses a deterministic doc ID
    // (email + event), so a second create for the same email/event is denied
    // because it would be an update. The confirmation-email Cloud Function
    // writes via the Admin SDK, which bypasses these rules.
    match /coronersCourtRegistrations/{regId} {
      allow read: if isAdmin();
      allow create: if
        request.resource.data.keys().hasOnly([
          'firstName', 'surname', 'position', 'specificRole', 'email',
          'baseStation', 'eventSelected', 'registeredAt', 'confirmationEmailSent'
        ]) &&
        request.resource.data.firstName is string &&
        request.resource.data.firstName.size() > 0 &&
        request.resource.data.firstName.size() <= 60 &&
        request.resource.data.surname is string &&
        request.resource.data.surname.size() > 0 &&
        request.resource.data.surname.size() <= 60 &&
        request.resource.data.position in [
          'Student paramedic', 'ECA', 'EAA', 'Technician',
          'Paramedic', 'HQ staff', 'Other'
        ] &&
        request.resource.data.specificRole is string &&
        request.resource.data.specificRole.size() <= 120 &&
        (
          !(request.resource.data.position in ['HQ staff', 'Other']) ||
          request.resource.data.specificRole.size() > 0
        ) &&
        request.resource.data.email is string &&
        request.resource.data.email.matches('[a-z0-9._%+-]+@swast\\.nhs\\.uk') &&
        request.resource.data.baseStation is string &&
        request.resource.data.baseStation.size() > 0 &&
        request.resource.data.baseStation.size() <= 120 &&
        request.resource.data.eventSelected in [
          'July 28th 10:00 at Exeter Coroners Court (County Hall)',
          'December 8th 10:00 at Derriford Coroners Court (Derriford)'
        ] &&
        request.resource.data.registeredAt == request.time &&
        request.resource.data.confirmationEmailSent == false;
      allow update, delete: if false;
    }
  }
}
